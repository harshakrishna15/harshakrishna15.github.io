---
import { projects } from '../data/projects';
---

<section id="projects" aria-labelledby="projects-heading">
  <header class="section-heading">
    <h2 id="projects-heading">Projects</h2>
  </header>
  <div id="tools" class="projects-grid">
    {projects.map(({ id, title, description, repository }, index) => (
      <article id={id} class={`panel project-entry project-${id}`}>
        <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="project-copy">
          <h3>{title}</h3>
          <p>{description}</p>
          <a class="text-link repository-link" href={repository} target="_blank" rel="noreferrer" aria-label={`View ${title} on GitHub`}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
