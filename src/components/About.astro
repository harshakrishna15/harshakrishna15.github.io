---
import { site } from '../data/site';
---

<section id="about" class="about-grid" aria-labelledby="about-heading">
  <div class="panel profile-panel">
    <h2 id="about-heading">About me</h2>
    <p>I’m interested in systems, cybersecurity, computer vision, and machine learning. My research has included autonomous driving datasets and vision-language methods for detecting road hazards.</p>
  </div>
  <section class="panel contact-panel">
    <h2>Contact</h2>
    <ul class="contact-links">
      <li><a href={site.linkedIn} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></li>
      <li><a href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
      <li>
        <button type="button" class="email-button" aria-controls="email-address" data-email-reveal hidden>Show email</button>
        <a id="email-address" class="email-address" href={`mailto:${site.email}`} hidden>{site.email}</a>
      </li>
    </ul>
  </section>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-email-reveal]');
  const address = document.querySelector<HTMLAnchorElement>('#email-address');

  if (button && address) {
    button.hidden = false;
    button.addEventListener('click', () => {
      address.hidden = false;
      button.hidden = true;
      address.focus({ preventScroll: true });
    }, { once: true });
  }
</script>
