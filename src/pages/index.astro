---
import About from '../components/About.astro';
import Papers from '../components/Papers.astro';
import Projects from '../components/Projects.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
---

<SiteLayout description={site.intro}>
  <section id="home" class="panel intro-panel" aria-labelledby="home-heading">
    <h1 id="home-heading">{site.name}</h1>
    <p class="intro">{site.intro}</p>
  </section>
  <About />
  <Projects />
  <Papers />
</SiteLayout>
