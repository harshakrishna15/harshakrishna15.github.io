---
import About from '../components/About.astro';
import Papers from '../components/Papers.astro';
import Projects from '../components/Projects.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
---

<SiteLayout description={site.intro}>
  <section id="home" class="opening-grid" aria-labelledby="home-heading">
    <div class="intro-panel">
      <h1 id="home-heading">{site.name}</h1>
      <p class="intro">{site.intro}</p>
    </div>
    <div class="screentone-panel" aria-hidden="true"></div>
  </section>
  <About />
  <Projects />
  <Papers />
</SiteLayout>
